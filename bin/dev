#!/usr/bin/env sh
# Runs a command in a PHP container when PHP is not installed locally: bin/dev composer check
# The image is composer:2 with pcntl, which parses the files in worker processes (ParallelExtraction), built once;
# `docker rmi phpgraph-dev` makes the next run build it again from the latest composer:2.
# Host network: containers cannot reach a local DNS resolver such as systemd-resolved (127.0.0.53).
IMAGE=phpgraph-dev
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    printf 'FROM composer:2\nRUN apk add --no-cache --virtual .build $PHPIZE_DEPS && docker-php-ext-install pcntl && apk del .build\n' \
        | docker build --network host -q -t "$IMAGE" - >&2 || exit 1
fi
exec docker run --rm -i --network host -v "$(pwd)":/app -w /app -u "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer "$IMAGE" "$@"
